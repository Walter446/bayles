# =============================
# 🤖 WHATSAPP BOT CONFIGURATION
# =============================

# Entorno
NODE_ENV=development
PORT=4000

# =============================
# 📱 WHATSAPP CONFIGURATION
# =============================

# Habilitar o deshabilitar WhatsApp
WHATSAPP_ENABLED=true

# Ruta donde se guardan las sesiones de autenticación
WHATSAPP_SESSION_PATH=./bot_sessions

# Timeout para reintentos de conexión (en milisegundos)
WHATSAPP_RETRY_TIMEOUT=5000

# Desconectar cuando se cierre la app
WHATSAPP_DISCONNECT_ON_CLOSE=false

# Sincronizar historial completo de mensajes
WHATSAPP_SYNC_FULL_HISTORY=false

# Marcar como en línea al conectarse
WHATSAPP_MARK_ONLINE=true

# =============================
# 🤖 AI AGENT CONFIGURATION
# =============================

# URL del servicio de IA (opcional)
AI_AGENT_SERVICE_URL=http://localhost:3000/api/ai-agent

# API Key de Gemini (si tienes un módulo de IA)
GEMINI_API_KEY=tu_api_key_aqui

# =============================
# 📊 JOBS SERVICE CONFIGURATION
# =============================

# URL del servicio de trabajos
JOBS_SERVICE_URL=http://localhost:3000/api/jobs

# =============================
# 🗄️ DATABASE CONFIGURATION (Ejemplo PostgreSQL)
# =============================

# Cambiar estos valores según tu BD
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bayles_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# =============================
# 🔐 SECURITY
# =============================

# JWT Secret (si usas autenticación)
JWT_SECRET=tu_jwt_secret_aqui

# =============================
# 📝 LOGGING
# =============================

LOG_LEVEL=debug
